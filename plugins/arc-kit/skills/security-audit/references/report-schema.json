          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          }
        },
        "required": [
          "verdict",
          "fingerprint",
          "title",
          "description",
          "claimed_root_cause",
          "trace",
          "evidence",
          "reason"
        ],
        "additionalProperties": false
