{
  "description": "Comment lint: flags wrapped, overlong, banner, and multi-line block comments added by apply_patch",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/comment-lint.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
