{
  "description": "Codex patch comment lint, new-test review, arc reload after compaction, and opt-in destructive shell guard.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "set -f; set -- $ARC_DESTRUCTIVE_GUARD_ENABLED; case \"$*\" in [Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss]|[Oo][Nn]) exec python3 \"${PLUGIN_ROOT}/scripts/destructive-guard.py\";; esac",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/comment-lint.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/test-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/arc-compact.py\"",
            "timeout": 10,
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
